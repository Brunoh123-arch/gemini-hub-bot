# ============================================================
# GEMINI HUB — CONFIGURAÇÃO DO BOT DE VENDAS NO TELEGRAM
# ============================================================
# Renomeie este arquivo para ".env" e preencha os seus dados.

# 1) Token obtido no @BotFather (obrigatório)
BOT_TOKEN=SEU_TOKEN_DO_BOTFATHER_AQUI

# 2) IDs numéricos do Telegram dos administradores (separados por vírgula)
ADMIN_IDS=123456789

# 3) Identidade da loja
STORE_NAME=Gemini Hub
SUPPORT_USERNAME=@SeuSuporteAqui
MIN_DEPOSIT_BRL=5.00
MAX_DEPOSIT_BRL=5000.00

# ============================================================
# 4) GATEWAY DE PAGAMENTOS PIX
# ============================================================
# Modos: hybrid | syncpay | auto (Mercado Pago) | manual (Chave Pix própria)
PIX_MODE=hybrid

# --- SyncPayments (Recomendado) ---
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_WEBHOOK_URL=
SYNCPAY_WEBHOOK_SECRET=
WEBHOOK_PORT=3000

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
PIX_POLL_INTERVAL_SECONDS=10

# --- Chave Pix Manual ---
PIX_KEY=sua-chave-pix@email.com
PIX_MERCHANT_NAME=GEMINI HUB DIGITAL
PIX_MERCHANT_CITY=SAO PAULO

# ============================================================
# 5) BANCO DE DADOS
# ============================================================
# Em produção na nuvem (Render + Supabase), preencha DATABASE_URL com Postgres:
DATABASE_URL=
# Localmente (se DATABASE_URL estiver vazio), usa SQLite neste arquivo:
DB_PATH=./data/geminihub.sqlite
SEED_DEMO_DATA=true
